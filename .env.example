# URL publique du site (utilisée par le sitemap, robots.txt et les meta OG)
# L'apex redirige en 308 vers www : c'est www qui est l'origine canonique.
NUXT_PUBLIC_SITE_URL=https://www.fabienlubin.fr

# --- SMTP (serveur uniquement, jamais exposé au client) ---
NUXT_SMTP_HOST=ssl0.ovh.net
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=bonjour@fabienlubin.fr
NUXT_SMTP_PASS=changeme
# Destinataire des messages du formulaire de contact
NUXT_SMTP_TO=bonjour@fabienlubin.fr
